        kind, detail = guest_verdict(data)
        guest_rows.append((domain, data, kind, detail))

# ---------- alerts ----------
alerts = []
if "load" in want:
    if load1 >= cpus:
        alerts.append(f"load {load1:.2f} is at or above {cpus} cores")
    avail, total = mem.get("MemAvailable", 0), mem.get("MemTotal", 1) or 1
    if avail and avail * 100 / total < 10:
        alerts.append(f"memory available {avail * 100 / total:.0f}%")
    if disk_pct >= 90:
        alerts.append(f"disk / is {disk_pct:.0f}% full")

if "hits" in want:
    if domain_filter and not site_rows:
        print(f"No Webalizer history for {domain_filter}")
        sys.exit(1)
    for row in sorted(site_rows, key=lambda r: -r["cur"].get("hits", 0)):
        hits = row["cur"].get("hits", 0)
        prev_hits = row["prev"].get("hits", 0)
        if hits >= threshold and (prev_hits == 0 or hits >= prev_hits * 3):
            if prev_hits:
                ratio = (hits - prev_hits) * 100 / prev_hits
                alerts.append(
                    f"{row['domain']}  {fmt_num(hits)} hits {month_label(cur_ym)} "
                    f"({fmt_num(prev_hits)} in {month_label(prev_ym)}, {ratio:+.0f}%)"
                )
            else:
                alerts.append(f"{row['domain']}  {fmt_num(hits)} hits {month_label(cur_ym)}")
        for h, path in row["urls"]:
            if h >= threshold:
                alerts.append(f"{row['domain']} {path}  {fmt_num(h)} hits")

if "guests" in want:
    for domain, data, kind, detail in guest_rows:
        if kind != "bots":
            continue
        guests = int(data.get("guests") or 0)
        hot = [
            h for h in data.get("hours") or []
            if h.get("hits", 0) >= 200 and h.get("ips", 0) >= h.get("hits", 1) * 0.85
        ]
        if guests >= 15 or hot:
            alerts.append(f"{domain} guest traffic looks like bots — {detail}")

if "mail" in want and mail.get("panic"):
    alerts.append(f"exim panic log has {len(mail['panic'])} lines")
try:
    qn = int(str(mail.get("queue", "0")).strip())
except ValueError:
    qn = 0
if "mail" in want and qn >= 50:
    alerts.append(f"exim queue has {qn} messages")

if "lsws" in want and not any("main" in p for p in lsws.get("procs", [])):
    alerts.append("OpenLiteSpeed is not running")

# ---------- render ----------
out = []
def add(line=""):
    out.append(line)

host = os.uname().nodename
try:
    host = subprocess.check_output(["hostname", "-f"], text=True).strip() or host
except Exception:
    pass
days, rem = divmod(int(uptime_s), 86400)
hours, mins = divmod(rem, 3600)[0], divmod(rem, 3600)[1] // 60

add(f"Server load — {host}")
add(now.strftime("%a %b %-d %H:%M:%S %Z %Y") + f"   up {days}d {hours}h {mins}m")
if domain_filter:
    add(f"Domain filter: {domain_filter}")
add()
add("ALERTS")
if alerts:
    for a in alerts:
        add(f"  {a}")
else:
    add("  none")
add()

if "load" in want:
    def gb(key):
        return mem.get(key, 0) / 1024 / 1024
    add("LOAD")
    add(f"  {load1:.2f}  {load5:.2f}  {load15:.2f}    {cpus} cores, 1m is {(load1 / cpus) * 100:.0f}% of capacity")
    add(f"  Mem   {gb('MemTotal') - gb('MemAvailable'):.1f}G used / {gb('MemTotal'):.1f}G    available {gb('MemAvailable'):.1f}G")
    if gb("SwapTotal"):
        add(f"  Swap  {gb('SwapTotal') - gb('SwapFree'):.1f}G used / {gb('SwapTotal'):.1f}G")
    gib = 1024 ** 3
    add(f"  Disk  /  {disk_used / gib:.0f}G / {disk_total / gib:.0f}G ({disk_pct:.0f}%)")
    add("  Top CPU")
    try:
        ps = subprocess.check_output(
            ["ps", "-eo", "pcpu,pmem,rss,args", "--sort=-pcpu", "--no-headers"], text=True
        )
    except Exception as exc:
        ps = ""
        add(f"    (ps failed: {exc})")
    shown = 0
    skip_re = re.compile(r"cursor-server|/bin/ps |da-load|python3 - ")
    for line in ps.splitlines():
        line = line.strip()
        if not line or skip_re.search(line):
            continue
        parts = line.split(None, 3)
        if len(parts) < 4:
            continue
        cpu, _pmem, rss, args = parts
        cmd = args if len(args) <= 72 else args[:69] + "..."
        add(f"    {float(cpu):5.1f}%  {int(rss) / 1024:7.0f}M  {cmd}")
        shown += 1
        if shown >= 6:
            break
    add()

if "hits" in want:
    add(f"HOT FILES  (Webalizer {month_label(cur_ym)}, through last tally)")
    if not site_rows:
        add("  no Webalizer history found")
    for row in sorted(site_rows, key=lambda r: -r["cur"].get("hits", 0)):
        cur, prev = row["cur"], row["prev"]
        hits = cur.get("hits", 0)
        if hits == 0 and not domain_filter:
            continue
        prev_hits = prev.get("hits", 0)
        extra = ""
        if prev_hits:
            extra = f"   prev {fmt_num(prev_hits)} ({(hits - prev_hits) * 100 / prev_hits:+.0f}%)"
        add(
            f"  {row['domain']:<28} {fmt_num(hits):>8} hits"
            f"  {fmt_num(cur.get('visits', 0)):>8} visits"
            f"  {fmt_kb(cur.get('kbytes', 0)):>10}{extra}"
        )
        top = row["urls"][:8]
        if not top:
            add("    (no URL table)")
        for h, path in top:
            mark = " !" if h >= threshold else ""
            add(f"    {fmt_num(h):>8}  {path}{mark}")
        mailers = [(h, p) for h, p in row["urls"] if re.search(r"mailer|send-mail", p, re.I)]
        shown_paths = {p for _h, p in top}
        for h, p in mailers:
            if p not in shown_paths:
                add(f"    {fmt_num(h):>8}  {p}")
        if not mailers:
            add("    mailer.php / send-mail.php: not in this month's URL table")
    add()
    add("TODAY  (vhost access logs, current file)")
    if not access_rows:
        add("  no access logs matched")
    watched_all = []
    for domain, scanned in sorted(access_rows, key=lambda r: -r[1]["total"]):
        bits = []
        for code in ("200", "301", "302", "304", "403", "404", "500", "503"):
            if scanned["statuses"].get(code):
                bits.append(f"{code}:{scanned['statuses'][code]}")
        add(f"  {domain:<28} {scanned['total']:>6} req   {'  '.join(bits)}")
        for path_s, n in scanned["paths"].most_common(5):
            add(f"    {n:>6}  {path_s}")
        for path_s, n in scanned["watched"].items():
            watched_all.append((n, domain, path_s))
    if watched_all:
        add("  Watched paths (mailer, .env, wp-login, xmlrpc, .git)")
        for n, domain, path_s in sorted(watched_all, key=lambda r: -r[0])[:lines_n]:
            add(f"    {n:>6}  {domain} {path_s}")
    elif access_rows:
        add("  Watched paths: none in today's logs")
    add()

if "topbyip" in want:
    add("TOP BY IP  (each vhost access log, current file)")
    if not access_rows:
        add("  no access logs matched")
    blocks = []
    lookup_ips = []
    seen_ips = set()
    for domain, scanned in sorted(access_rows, key=lambda r: (-r[1]["total"], r[0])):
        ranked = scanned["ips"].most_common(ip_cap if ip_cap > 0 else None)
        blocks.append((domain, scanned, ranked))
        for ip, _n in ranked:
            if ip not in seen_ips:
                seen_ips.add(ip)
                lookup_ips.append(ip)
    names = rev_many(lookup_ips)
    for domain, scanned, ranked in blocks:
        ips = scanned["ips"]
        add(f"  {domain:<28} {scanned['total']:>6} req   {len(ips)} ips")
        for ip, n in ranked:
            pct = (n * 100 / scanned["total"]) if scanned["total"] else 0
            name = names.get(ip) or ""
            add(f"    {n:>7}  {pct:5.1f}%  {ip}" + (f"  {name}" if name else ""))
        hidden = len(ips) - len(ranked)
        if hidden > 0:
            add(f"    {hidden} more ips")
    add()

if "guests" in want:
    add("GUESTS  (shop presence, last 10 minutes; shape is the last 30)")
    if domain_filter and not guest_rows:
        add(f"  {domain_filter} has no shop presence table")
    elif not guest_rows:
        add("  no shop with a presence table")
    for domain, data, kind, detail in guest_rows:
        if data.get("error"):
            add(f"  {domain:<28} {detail}")
            continue
        act = data.get("activity") or {}
        member_n = int(data.get("members") or 0)
        member_label = "member" if member_n == 1 else "members"
        add(
            f"  {domain:<28} {data.get('guests', 0)} guests"
            f"   {member_n} {member_label}"
            f"   {data.get('live_paths', 0)} urls"
            f"   {data.get('live_products', 0)} product hits"
        )
        add(f"    {kind} — {detail}")
        add(
            f"    30m  {act.get('hits', 0)} hits"
            f"   {act.get('ips', 0)} ips"
            f"   {act.get('sessions', 0)} sessions"
            f"   {act.get('product_urls', 0)} product urls"
        )
        repeated = data.get("repeated") or []
        if repeated:
            add("    repeated in the live window:")
            for row in repeated:
                add(f"      {row.get('n', 0):>4}  {row.get('path', '')}")
        else:
            add("    repeated in the live window: none")
        browsers = data.get("browsers") or []
        if browsers:
            bits = "   ".join(f"{b.get('name')} {b.get('n')}" for b in browsers)
            add(f"    browsers  {bits}")
        prefixes = data.get("prefixes") or []
        if prefixes:
            bits = "   ".join(f"{p.get('prefix')} {p.get('n')}" for p in prefixes)
            add(f"    prefixes  {bits}")
        hours = data.get("hours") or []
        hot = [
            h for h in hours
            if h.get("hits", 0) >= 100 and h.get("ips", 0) >= h.get("hits", 1) * 0.85
        ]
        if hot:
            add(f"    bot-shaped hours, last 24h ({data.get('tz', '')}):")
            for h in hot:
                add(f"      {h.get('label')}  {h.get('hits')} hits  {h.get('ips')} ips")
        elif hours:
            last = hours[-1]
            add(
                f"    last hour {last.get('label')} ({data.get('tz', '')}):"
                f"  {last.get('hits')} hits  {last.get('ips')} ips"
            )
    add()

if "mail" in want:
    add("MAIL")
    add(f"  Exim queue: {mail['queue']}")
    add(f"  Panic log: {len(mail['panic'])} lines ({EXIM_PANIC})")
