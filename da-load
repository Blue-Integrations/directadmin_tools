def discover_shops():
    found = []
    if not os.path.isdir("/home"):
        return found
    for user in sorted(os.listdir("/home")):
        domains = os.path.join("/home", user, "domains")
        if not os.path.isdir(domains):
            continue
        for domain in sorted(os.listdir(domains)):
            if domain in SKIP_DOMAINS:
                continue
            if domain_filter and domain != domain_filter:
                continue
            boot = os.path.join(domains, domain, "public_html", "includes", "bootstrap.php")
            if os.path.isfile(boot):
                found.append((domain, boot))
    return found

def guest_snapshot(boot):
    try:
        proc = subprocess.run(
            ["php", "-r", GUEST_PHP, boot],
            capture_output=True, text=True, timeout=40,
        )
    except Exception as exc:
        return {"error": str(exc)}
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "php failed").strip().splitlines()
        return {"error": err[-1][:180] if err else "php failed"}
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {"error": "shop query did not return JSON"}
    if not isinstance(data, dict):
        return {"error": "shop query did not return JSON"}
    return data

def guest_verdict(data):
    if data.get("error"):
        return "skip", data["error"]
    guests = int(data.get("guests") or 0)
    act = data.get("activity") or {}
    hits = int(act.get("hits") or 0)
    ips = int(act.get("ips") or 0)
    sess = int(act.get("sessions") or 0)
    ph = int(act.get("product_hits") or 0)
    pu = int(act.get("product_urls") or 0)
    top_n = int(act.get("top_n") or 0)
    top_path = str(act.get("top_path") or "")
    one_each = hits >= 8 and ips >= hits * 0.9 and sess >= hits * 0.9
    if guests < 8 and hits < 30:
        return "quiet", f"{guests} guests in the last 10 minutes"
    if one_each and ph >= 8 and pu >= ph * 0.8:
        if top_n and top_n / ph >= 0.5:
            return "bots", f"mostly one product ({top_path}, {top_n} of {ph})"
        return "bots", f"multiple products, one page each ({pu} urls, {ph} hits)"
    if one_each:
        return "bots", "one address and one session per hit"
    return "mixed", "some sessions opened more than one page"

